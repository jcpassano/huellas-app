# Copiá este archivo a .env para probar en tu máquina, o cargá estas
# mismas variables en la configuración de la App en DigitalOcean.

# Cadena de conexión a Postgres (DigitalOcean te la da armada al crear
# la base de datos administrada, o el "Dev Database" de App Platform).
DATABASE_URL=postgresql://usuario:clave@host:25060/huellas?sslmode=require

# Si tu proveedor de Postgres usa un certificado propio y falla la conexión,
# probá con PGSSL=false (no recomendado en producción, pero sirve para debug).
# PGSSL=false

# Clave secreta para firmar las sesiones (inventá una larga y random).
JWT_SECRET=cambiame-por-algo-largo-y-random

# --- Fotos ---
# Si dejás estas tres vacías, las fotos se guardan en disco local (sirve
# para probar, pero se pierden en cada redeploy de App Platform).
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Opcional: si activaste un CDN endpoint para el Space, pegalo acá.
# SPACES_CDN_BASE=https://tu-space.nyc3.cdn.digitaloceanspaces.com

PORT=8080
NODE_ENV=production
